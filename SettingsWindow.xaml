<Window x:Class="Dnex.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Dnex.Controls"
        Title="CHIMERION · Настройки" Icon="/Assets/chimerion-logo.png" Width="980" Height="680" MinWidth="820" MinHeight="520"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Window.Resources>
        <!-- Заголовок раздела внутри вкладки: маленькие заглавные буквы, приглушенный цвет -->
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,22,0,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FieldHint" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="LineHeight" Value="18"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="Para" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>
        <!-- Пункт боковой панели: значок и название, у выбранного акцентная полоска слева и подсветка -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="nav"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8">
                            <Grid>
                                <Border x:Name="sel" Background="{DynamicResource AccentSoft}" CornerRadius="8" Opacity="0"/>
                                <Border x:Name="bar" Width="3" CornerRadius="2" HorizontalAlignment="Left" Margin="0,8" Background="{DynamicResource Accent}" Opacity="0"/>
                                <ContentPresenter VerticalAlignment="Center" Margin="14,9,12,9"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="sel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="bar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="sel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="bar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Боковая панель ===== -->
        <Border Grid.Column="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,20,16,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,22">
                    <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource AccentSoft}">
                        <controls:BrandMark Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Настройки" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SideVersion" Text="CHIMERION" Style="{StaticResource Label}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Язык интерфейса: переключается сразу, без «Сохранить» -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <TextBlock Text="ЯЗЫК" Style="{StaticResource Label}" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,6"/>
                    <Border Padding="3" CornerRadius="9" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Border}" BorderThickness="1" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="LangRu" Style="{StaticResource Tab}" GroupName="lang" Content="Русский" Checked="Lang_Checked" Tag="ru"/>
                            <RadioButton x:Name="LangEn" Style="{StaticResource Tab}" GroupName="lang" Content="English" Checked="Lang_Checked" Tag="en"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="Nav">
                    <RadioButton Style="{StaticResource NavItem}" Tag="General" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal"><controls:Icon Kind="settings" Size="16" Margin="0,0,11,0"/><TextBlock Text="Основные" VerticalAlignment="Center"/></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" Tag="Privacy" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal"><controls:Icon Kind="eye-off" Size="16" Margin="0,0,11,0"/><TextBlock Text="Приватность" VerticalAlignment="Center"/></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" Tag="Check" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal"><controls:Icon Kind="activity" Size="16" Margin="0,0,11,0"/><TextBlock Text="Проверка серверов" VerticalAlignment="Center"/></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" Tag="Watch" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal"><controls:Icon Kind="shield-check" Size="16" Margin="0,0,11,0"/><TextBlock Text="Сторож и трей" VerticalAlignment="Center"/></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" Tag="Split" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal"><controls:Icon Kind="arrow-left-right" Size="16" Margin="0,0,11,0"/><TextBlock Text="Два DNS" VerticalAlignment="Center"/></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" Tag="Look" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal"><controls:Icon Kind="sliders-horizontal" Size="16" Margin="0,0,11,0"/><TextBlock Text="Внешний вид" VerticalAlignment="Center"/></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" Tag="Data" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal"><controls:Icon Kind="scroll-text" Size="16" Margin="0,0,11,0"/><TextBlock Text="Данные" VerticalAlignment="Center"/></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" Tag="About" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal"><controls:Icon Kind="info" Size="16" Margin="0,0,11,0"/><TextBlock Text="О программе" VerticalAlignment="Center"/></StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Содержимое вкладки ===== -->
        <DockPanel Grid.Column="1">
            <StackPanel DockPanel.Dock="Top" Margin="32,24,32,0">
                <TextBlock x:Name="PageTitle" Text="Основные" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock x:Name="PageHint" Style="{StaticResource Label}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Нижняя панель: сообщение отдельной строкой, кнопки справа -->
            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="32,14,32,16">
                <StackPanel>
                    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Bad}" TextWrapping="Wrap" Margin="0,0,0,10" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <DockPanel LastChildFill="False">
                        <Button Content="Сохранить" DockPanel.Dock="Right" Style="{StaticResource Primary}" IsDefault="True" Click="Save_Click" MinWidth="130"/>
                        <Button Content="Отмена" DockPanel.Dock="Right" Style="{StaticResource Ghost}" IsCancel="True" Click="Cancel_Click"/>
                        <Button x:Name="DefaultsButton" Content="Рекомендуемые значения" DockPanel.Dock="Left" Style="{StaticResource Ghost}" Click="Defaults_Click" Margin="-16,0,0,0"
                                ToolTip="Поставить во все поля рекомендуемые значения. Сохранятся только после «Сохранить»"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <ScrollViewer x:Name="BodyScroll" VerticalScrollBarVisibility="Auto" Padding="32,6,22,24" controls:SmoothScroll.IsEnabled="True">
                <Grid x:Name="Pages">

                    <!-- Основные -->
                    <StackPanel x:Name="PageGeneral" Tag="Основные|Как программа запускается, прячется и обновляется">
                        <TextBlock Text="ЗАПУСК И ОКНО" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Card}" Padding="18">
                            <StackPanel>
                                <CheckBox x:Name="AutoStartBox" Content="Запускать вместе с Windows (рекомендуем)"/>
                                <TextBlock Text="Стартует в трее без прав администратора. Права спросит, только чтобы вернуть DNS" Style="{StaticResource FieldHint}" Margin="26,4,0,0"/>
                                <CheckBox x:Name="CloseToTrayBox" Content="Крестик прячет программу в трей (рекомендуем)" Margin="0,14,0,0"/>
                                <TextBlock Text="Подключение продолжает работать, программа открывается из трея" Style="{StaticResource FieldHint}" Margin="26,4,0,0"/>
                                <CheckBox x:Name="StartCompactBox" Content="Открывать программу в компактном виде" Margin="0,14,0,0"/>
                                <TextBlock Text="Узкое окно с кнопкой подключения и рабочими серверами. Если выключено, открывается в том виде, в каком закрыли" Style="{StaticResource FieldHint}" Margin="26,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="ОБНОВЛЕНИЯ" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Card}" Padding="18">
                            <StackPanel>
                                <CheckBox x:Name="CheckUpdatesBox" Content="Проверять новую версию в фоне (рекомендуем)"/>
                                <TextBlock Text="При запуске и раз в 6 часов. Обновление ставится одной кнопкой, программа сама перезапустится" Style="{StaticResource FieldHint}" Margin="26,4,0,0"/>
                                <StackPanel x:Name="RollbackPanel" Visibility="Collapsed" Margin="0,14,0,0">
                                    <TextBlock x:Name="RollbackHint" Style="{StaticResource FieldHint}" TextWrapping="Wrap" Margin="0"/>
                                    <Button x:Name="RollbackButton" Click="Rollback_Click" Style="{StaticResource Strong}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Приватность (PrivacyGuard) -->
                    <StackPanel x:Name="PagePrivacy" Visibility="Collapsed" Tag="Приватность|Чтобы ваши данные не попали на скриншот, запись или трансляцию экрана">
                        <TextBlock Text="СКРЫТИЕ ДАННЫХ" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Card}" Padding="18">
                            <StackPanel>
                                <CheckBox x:Name="PrivacyBox" Content="Скрывать данные от записи экрана (Стример мод)" Checked="Privacy_Checked"/>
                                <TextBlock Text="Окна не попадут на скриншоты, запись и трансляции, а IP, город и провайдер скрыты"
                                           Style="{StaticResource FieldHint}" Margin="26,4,0,0"/>
                                <CheckBox x:Name="MaskOnlyBox" Content="Только скрывать данные" Checked="Privacy_Checked" Margin="0,14,0,0"/>
                                <TextBlock Text="IP, город и провайдер скрыты, а окна на записи видны как обычно"
                                           Style="{StaticResource FieldHint}" Margin="26,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="ЧТО СКРЫВАЕТСЯ" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Card}" Padding="18">
                            <StackPanel>
                                <TextBlock Text="В обоих режимах" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Para}" Foreground="{DynamicResource Text}" Margin="0,6,0,0" Text="• Ваш внешний IP, город и провайдер на экране: в журнале, проверке и диагностике. Адреса DNS-серверов и страны остаются"/>
                                <TextBlock Text="Только «Скрывать данные от записи экрана»" FontWeight="SemiBold" Margin="0,14,0,0"/>
                                <TextBlock x:Name="StreamerState" Style="{StaticResource FieldHint}" Margin="0,2,0,0"/>
                                <StackPanel x:Name="StreamerOnly">
                                    <TextBlock Style="{StaticResource Para}" Foreground="{DynamicResource Text}" Margin="0,6,0,0" Text="• Окна, меню и подсказки не видны в OBS, Discord, Zoom, Teams, «Ножницах» и на Print Screen"/>
                                    <TextBlock Style="{StaticResource Para}" Foreground="{DynamicResource Text}" Margin="0,6,0,0" Text="• Миниатюры на панели задач и в Alt+Tab: вместо окна значок"/>
                                </StackPanel>
                                <TextBlock Text="Всегда, даже без скрытия" FontWeight="SemiBold" Margin="0,14,0,0"/>
                                <TextBlock Style="{StaticResource Para}" Foreground="{DynamicResource Text}" Margin="0,6,0,0" Text="• В скопированном журнале и отчетах внешний IP, адреса локальной сети, имя пользователя Windows и почта заменяются метками. Произвольный текст, который вы сами вписали в поля, программа не правит"/>
                                <TextBlock Style="{StaticResource FieldHint}" FontSize="12" Margin="0,12,0,0" Text="Не скроет то, что уже записано, и не защитит от камеры или программ с правами администратора. На Windows 10 до версии 2004 окно на записи будет черным"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="ОБЩАЯ КАРТА СЕРВЕРОВ" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Card}" Padding="18">
                            <StackPanel>
                                <CheckBox x:Name="CrowdBox" Content="Помогать общей карте серверов"/>
                                <TextBlock Text="Раз в час уходят итоги проверок: адрес DNS-сервера, его название или адрес DoH, какой сервис проверялся, открылся ли он, и версия программы. Сайты, которые вы открываете, не уходят"
                                           Style="{StaticResource FieldHint}" Margin="26,4,0,0"/>
                                <TextBlock Text="Сервер общей карты, как любой сайт, видит ваш IP во время запроса: он нужен только для лимита отчетов в час и не сохраняется. Сохраняется номер сети провайдера (AS), чтобы рейтинг был по вашему провайдеру. Рейтинг виден и без галочки"
                                           Style="{StaticResource FieldHint}" Margin="26,6,0,0"/>
                                <TextBlock Margin="26,6,0,0" FontSize="12.5"><Hyperlink Click="CrowdCode_Click" Foreground="{DynamicResource Accent}">Код сервера общей карты на GitHub</Hyperlink></TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Проверка серверов -->
                    <StackPanel x:Name="PageCheck" Visibility="Collapsed" Tag="Проверка серверов|Как CHIMERION проверяет, работает ли сервер с ИИ-сервисами">
                        <TextBlock Text="ПРОВЕРОЧНЫЙ DNS" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Card}" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Честный DNS для сравнения (DoH)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="RefDoh" Style="{StaticResource FieldBox}"/>
                                <TextBlock Text="Программа спрашивает адрес ChatGPT у него и у проверяемого сервера. Если ответы разные, сервер ведет нейросети через себя, то есть работает как Smart DNS. Менять стоит, только если этот адрес у вас не открывается. Начинается с https://" Style="{StaticResource FieldHint}"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="СКОРОСТЬ И НАГРУЗКА" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Card}" Padding="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Таймаут проверки, сек" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TimeoutBox" Style="{StaticResource FieldBox}"/>
                                    <TextBlock Text="от 2 до 30. Рекомендуем 6" Style="{StaticResource FieldHint}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Проверок одновременно" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="ParallelBox" Style="{StaticResource FieldBox}"/>
                                    <TextBlock Text="от 1 до 64. Рекомендуем 24, так стоит по умолчанию. Меньше, если сеть слабая или проверка мешает другим программам" Style="{StaticResource FieldHint}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Обновлять пинг, мин" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="PingBox" Style="{StaticResource FieldBox}"/>
                                    <TextBlock Text="от 1 до 60. Рекомендуем 10. Таблица, шапка и трей" Style="{StaticResource FieldHint}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Сторож и трей -->
                    <StackPanel x:Name="PageWatch" Visibility="Collapsed" Tag="Сторож и трей|Как часто программа следит за подключением и проверяет сервисы">
                        <TextBlock Text="ИНТЕРВАЛЫ" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Card}" Padding="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Сторож DNS, сек" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="WatchdogBox" Style="{StaticResource FieldBox}"/>
                                    <TextBlock Text="от 15 до 600. Рекомендуем 60. Работает, пока подключено" Style="{StaticResource FieldHint}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Проверка сервисов в трее, мин" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TrayMinutesBox" Style="{StaticResource FieldBox}"/>
                                    <TextBlock Text="от 1 до 60. Рекомендуем 15: чаще значит лишние запросы к сервисам с вашего адреса" Style="{StaticResource FieldHint}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock Text="ПРОВЕРКА СЕРВИСОВ" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Card}" Padding="18">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Para}" Text="Пока вы подключены, программа следит за ChatGPT, Claude, Gemini и самим сервером. Если что-то упало, придет уведомление с причиной"/>
                                <CheckBox x:Name="AutoSwitchBox" Content="Переключаться, когда нейросеть перестала открываться" Margin="0,14,0,0"/>
                                <TextBlock Text="Если ChatGPT, Claude или Gemini перестали открываться через текущий сервер, программа сама перейдет на лучший рабочий. Иначе только уведомление. Работает, если ниже разрешено «Программа может сама переходить на другой сервер»" Style="{StaticResource FieldHint}" Margin="26,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="НАБЛЮДЕНИЕ ЗА САЙТАМИ" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Card}" Padding="18">
                            <StackPanel>
                                <CheckBox x:Name="SiteWatchBox" Content="Следить за сайтами, которыми я пользуюсь (рекомендуем)"/>
                                <TextBlock Text="Сообщит, если сайт, которым вы пользуетесь, перестал открываться, и скажет почему. Список хранится только у вас: «Помощь» → «Сайты под наблюдением»" Style="{StaticResource FieldHint}" Margin="26,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="СМЕНА СЕРВЕРА И АККАУНТЫ" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Card}" Padding="18">
                            <StackPanel>
                                <CheckBox x:Name="AllowSwitchBox" Content="Программа может сама переходить на другой сервер" Checked="AllowSwitch_Changed" Unchecked="AllowSwitch_Changed"/>
                                <TextBlock Text="Главный переключатель: без него сервер меняете только вы, и страна, из которой вас видят нейросети, сама не поменяется. От него зависят переключение выше и запасной сервер ниже" Style="{StaticResource FieldHint}" Margin="26,4,0,0"/>
                                <CheckBox x:Name="BackupBox" Content="Ставить запасной сервер (рекомендуем)" Margin="26,14,0,0"/>
                                <TextBlock Text="Второй сервер с той же страной выхода. Если основной перестанет отвечать вовсе, Windows перейдет на него за секунды. Доступен, когда включено «Программа может сама переходить»" Style="{StaticResource FieldHint}" Margin="52,4,0,0"/>
                                <CheckBox x:Name="SafetyBox" Content="Защита аккаунтов (рекомендуем)" Margin="0,14,0,0"/>
                                <TextBlock Text="Помнит, из какой страны вас видят сервисы, и не меняет ее без вашего согласия: смена страны повышает риск блокировки" Style="{StaticResource FieldHint}" Margin="26,4,0,0"/>
                                <DockPanel x:Name="CountryRow" Margin="26,14,0,0">
                                    <ContentControl x:Name="CountryHost" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <StackPanel>
                                        <TextBlock Text="Страна выхода для нейросетей" FontWeight="SemiBold"/>
                                        <TextBlock Text="Программа подключит и подберет замену только с выходом в этой стране. «Любая»: без закрепления, но защита аккаунтов все равно держит страну, из которой вас уже видели, и спросит перед ее сменой" Style="{StaticResource FieldHint}" Margin="0,4,12,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="ЧТО ДЕЛАЕТ СТОРОЖ" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Card}" Padding="18">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Para}" Text="Пока вы подключены, сторож следит за DNS. Если его сбросили, вернет подключение, а если сервер умер, переключит на другой, когда это разрешено выше."/>
                                <TextBlock Style="{StaticResource Para}" Margin="0,8,0,0" Text="Со сторонним VPN сторож не спорит. Если DNS сбрасывают снова и снова, он отступит и подскажет, что делать."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Два DNS -->
                    <StackPanel x:Name="PageSplit" Visibility="Collapsed" Tag="Два DNS|ИИ через Smart DNS, остальной интернет через обычный DNS">
                        <TextBlock Text="РЕЖИМ" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Card}" Padding="18">
                            <StackPanel>
                                <TextBlock x:Name="SplitStatus" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                <TextBlock Text="Только запросы нейросетей идут через Smart DNS, остальные сайты через обычный DNS. Так меньше сайтов зависят от Smart DNS: если с ним что-то случится, остальной интернет не заденет"
                                           Style="{StaticResource FieldHint}" Margin="0,6,0,0"/>
                                <Button Content="Настроить два DNS" Click="SplitDns_Click" Style="{StaticResource Strong}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="КУДА ИДУТ ЗАПРОСЫ" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Card}" Padding="18">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource Surface2}" CornerRadius="10" Padding="14,10">
                                        <StackPanel><TextBlock Text="ChatGPT, Claude, Gemini" FontWeight="SemiBold"/><TextBlock Text="и ваши домены из «Два DNS»" Style="{StaticResource FieldHint}" Margin="0,2,0,0"/></StackPanel>
                                    </Border>
                                    <controls:Icon Grid.Column="1" Kind="arrow-left-right" Size="18" Margin="14,0" VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/>
                                    <Border Grid.Column="2" Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="14,10">
                                        <StackPanel><TextBlock Text="Smart DNS" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/><TextBlock Text="открывает нейросети из России" Style="{StaticResource FieldHint}" Margin="0,2,0,0"/></StackPanel>
                                    </Border>
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource Surface2}" CornerRadius="10" Padding="14,10">
                                        <StackPanel><TextBlock Text="Все остальные сайты" FontWeight="SemiBold"/><TextBlock Text="банки, госуслуги, магазины" Style="{StaticResource FieldHint}" Margin="0,2,0,0"/></StackPanel>
                                    </Border>
                                    <controls:Icon Grid.Column="1" Kind="arrow-left-right" Size="18" Margin="14,0" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
                                    <Border Grid.Column="2" Background="{DynamicResource Surface2}" CornerRadius="10" Padding="14,10">
                                        <StackPanel><TextBlock Text="Обычный DNS" FontWeight="SemiBold"/><TextBlock Text="вашей сети или выбранный в «Два DNS»" Style="{StaticResource FieldHint}" Margin="0,2,0,0"/></StackPanel>
                                    </Border>
                                </Grid>
                                <TextBlock Text="Без «Двух DNS» через Smart DNS идут все запросы. Это тоже работает, просто сильнее зависит от одного сервера" Style="{StaticResource FieldHint}" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Внешний вид (SettingsColors.cs) -->
                    <StackPanel x:Name="PageLook" Visibility="Collapsed" Tag="Внешний вид|Тема и цвета интерфейса. Меняются сразу, чтобы было видно результат">
                        <TextBlock Text="ТЕМА И ЦВЕТА" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Card}" Padding="18">
                            <StackPanel x:Name="ColorsHost"/>
                        </Border>
                    </StackPanel>

                    <!-- Данные -->
                    <StackPanel x:Name="PageData" Visibility="Collapsed" Tag="Данные|Где программа хранит настройки, список серверов и журнал">
                        <TextBlock Text="ПАПКА ДАННЫХ" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Card}" Padding="18">
                            <StackPanel>
                                <Border Background="{DynamicResource Surface2}" CornerRadius="8" Padding="12,9" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                    <TextBlock x:Name="DataPathText" TextWrapping="Wrap" FontSize="12" FontFamily="Cascadia Mono, Consolas"/>
                                </Border>
                                <TextBlock Text="Не передавайте settings.json: в нем могут быть ваши Cookie. Для поддержки используйте «Скопировать отчет» в диагностике"
                                           Style="{StaticResource FieldHint}" Margin="0,8,0,0"/>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="Открыть папку данных" Click="OpenData_Click" Style="{StaticResource Strong}" Margin="0,0,8,0"/>
                                    <Button Content="Открыть журналы" Click="OpenLogs_Click" Style="{StaticResource Strong}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="ЧТО ВНУТРИ" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Card}" Padding="18">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Text="settings.json" FontFamily="Cascadia Mono, Consolas" Margin="0,0,0,8"/>
                                <TextBlock Grid.Column="1" Text="настройки программы" Style="{StaticResource FieldHint}" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="1" Text="servers.json" FontFamily="Cascadia Mono, Consolas" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="список серверов и итоги их проверок" Style="{StaticResource FieldHint}" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="2" Text="logs" FontFamily="Cascadia Mono, Consolas" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="журнал за 3 дня, старое удаляется само" Style="{StaticResource FieldHint}" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="3" Text="dns-backup.json" FontFamily="Cascadia Mono, Consolas" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="исходные DNS до первого подключения: по ним программа и reset-dns.cmd все возвращают" Style="{StaticResource FieldHint}" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="4" Text="tools.json" FontFamily="Cascadia Mono, Consolas"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="состояние zapret и TG WS Proxy" Style="{StaticResource FieldHint}"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- О программе -->
                    <StackPanel x:Name="PageAbout" Visibility="Collapsed" Tag="О программе|Что это, кто автор и на каких условиях можно пользоваться">
                        <Border Style="{StaticResource Card}" Padding="22" Margin="0,16,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="64" Height="64" CornerRadius="18" Background="{DynamicResource AccentSoft}">
                                        <controls:BrandMark Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                                        <controls:BrandWordmark Height="20" HorizontalAlignment="Left"/>
                                        <TextBlock x:Name="VersionText" Text="CHIMERION" Style="{StaticResource Label}" FontSize="12" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Para}" Margin="0,18,0,0" Foreground="{DynamicResource Text}"
                                           Text="Сетевые инструменты для открытого интернета: ChatGPT, Claude и Gemini без VPN, обход замедления YouTube и Discord, быстрый Telegram."/>
                                <TextBlock Style="{StaticResource Para}" Margin="0,8,0,0"
                                           Text="Сама находит и проверяет серверы, подключается в один клик и все возвращает, если что-то пошло не так. Права администратора нужны только для смены DNS."/>
                                <TextBlock Margin="0,14,0,0">
                                    <Hyperlink Click="Site_Click" Foreground="{DynamicResource Accent}">chimerion.dev</Hyperlink>
                                    <Run Text=" · сайт программы" Foreground="{DynamicResource Muted}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="TELEGRAM" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Card}" Padding="18">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Text="Канал" Style="{StaticResource Label}" Margin="0,0,0,10"/>
                                    <TextBlock Grid.Column="1" Margin="0,0,0,10">
                                        <Hyperlink Click="TgChannel_Click" Foreground="{DynamicResource Accent}">@chimeriondns</Hyperlink>
                                        <Run Text=" · новости о версиях" Foreground="{DynamicResource Muted}"/>
                                    </TextBlock>
                                    <TextBlock Grid.Row="1" Text="Чат" Style="{StaticResource Label}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1">
                                        <Hyperlink Click="TgChat_Click" Foreground="{DynamicResource Accent}">Chimerion DNS Chat</Hyperlink>
                                        <Run Text=" · помощь, рабочие DNS, идеи" Foreground="{DynamicResource Muted}"/>
                                    </TextBlock>
                                </Grid>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="Баг-репорты" Click="TgTopic_Click" Tag="bugs" Style="{StaticResource Strong}" Margin="0,0,8,0" ToolTip="Тема чата в Telegram"/>
                                    <Button Content="Идеи" Click="TgTopic_Click" Tag="ideas" Style="{StaticResource Strong}" Margin="0,0,8,0" ToolTip="Тема чата в Telegram"/>
                                    <Button Content="Ошибки" Click="TgTopic_Click" Tag="help" Style="{StaticResource Strong}" ToolTip="Тема чата в Telegram"/>
                                </WrapPanel>
                                <TextBlock Style="{StaticResource FieldHint}" FontSize="12" Margin="0,6,0,0"
                                           Text="Кнопки открывают темы чата в Telegram. Если вы еще не в чате, сначала вступите по ссылке выше."/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="АВТОР И ЛИЦЕНЗИЯ" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Card}" Padding="18">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Text="Автор" Style="{StaticResource Label}" Margin="0,0,0,10"/>
                                    <TextBlock Grid.Column="1" Text="under2ker" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <TextBlock Grid.Row="1" Text="Лицензия" Style="{StaticResource Label}" Margin="0,0,0,10"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="PolyForm Noncommercial 1.0.0" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <TextBlock Grid.Row="2" Text="Исходный код" Style="{StaticResource Label}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1">
                                        <Hyperlink Click="Repo_Click" Foreground="{DynamicResource Accent}">github.com/under2ker/chimerion</Hyperlink>
                                    </TextBlock>
                                </Grid>
                                <TextBlock Style="{StaticResource FieldHint}" Margin="0,14,0,0" FontSize="12"
                                           Text="Программу можно использовать, копировать и менять в некоммерческих целях. Продавать ее или брать деньги за сборки нельзя."/>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="История изменений" Click="Changelog_Click" Style="{StaticResource Strong}" Margin="0,0,8,0" ToolTip="Откроется на GitHub"/>
                                    <Button Content="Сообщить о проблеме" Click="Issues_Click" Style="{StaticResource Strong}" Margin="0,0,8,0" ToolTip="Откроется на GitHub"/>
                                    <Button Content="Текст лицензии" Click="License_Click" Style="{StaticResource Ghost}" ToolTip="Откроется на GitHub"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Expander Header="Сторонние компоненты и их лицензии" Margin="0,18,0,0" Foreground="{DynamicResource Muted}">
                        <Border Style="{StaticResource Card}" Padding="18" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldHint}" FontSize="12" Margin="0" Text="TG WS Proxy и zapret-discord-youtube (Flowseal, bol-van; WinDivert, basil00): лицензия MIT. CHIMERION ставит их официальные релизы с GitHub после проверки контрольной суммы."/>
                                <TextBlock Style="{StaticResource FieldHint}" FontSize="12" Margin="0,8,0,0" Text="Списки сайтов и адресов: v2fly/domain-list-community, Re:filter, eduard256/russia-blocked-ips, RussiaFancyLists (MIT)."/>
                                <TextBlock Style="{StaticResource FieldHint}" FontSize="12" Margin="0,8,0,0" Text="Анимированные иконки useanimations.com (MIT), остальные Lucide (ISC). Логотипы ChatGPT, Claude и Gemini из Simple Icons (CC0) принадлежат своим владельцам."/>
                            </StackPanel>
                        </Border>
                        </Expander>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
