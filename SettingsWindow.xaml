<Window x:Class="Dnex.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Dnex.Controls"
        Title="CHIMERION · Настройки" Icon="/Assets/chimerion-logo.png" Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Window.Resources>
        <!-- Заголовок раздела: маленькие заглавные буквы, приглушенный цвет -->
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,20,0,8"/>
        </Style>
        <!-- Подпись поля над полем ввода -->
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <!-- Пояснение под полем -->
        <Style x:Key="FieldHint" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- Поле ввода одинаковой высоты -->
        <Style x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="24,22,24,20">
        <!-- Шапка: логотип и название -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" LastChildFill="False">
            <!-- Язык интерфейса: на виду в шапке, переключается сразу (Services/Loc) -->
            <Border DockPanel.Dock="Right" Padding="3" CornerRadius="9" Background="{DynamicResource Surface2}" VerticalAlignment="Center"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1" ToolTip="Язык интерфейса">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="LangRu" Style="{StaticResource Tab}" GroupName="lang" Content="Русский" Checked="Lang_Checked" Tag="ru"/>
                    <RadioButton x:Name="LangEn" Style="{StaticResource Tab}" GroupName="lang" Content="English" Checked="Lang_Checked" Tag="en"/>
                </StackPanel>
            </Border>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
            <!-- Шапка как у остальных окон: значок в цветном квадрате, заголовок и пояснение (DnexDialog.Header) -->
            <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource InfoSoft}" VerticalAlignment="Center">
                <controls:Icon Kind="settings" Size="19" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Настройки" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Text="Изменения применяются после «Сохранить»" Style="{StaticResource Label}" FontSize="12" Margin="0,3,0,0"/>
            </StackPanel>
        </StackPanel>
        </DockPanel>

        <!-- Нижняя панель: ошибка слева, кнопки справа -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,16,0,0">
            <StackPanel>
            <!-- Сообщение отдельной строкой над кнопками: длинный текст переносится, а кнопки не растягиваются.
                 Пустое сообщение места не занимает -->
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Bad}" TextWrapping="Wrap" Margin="0,0,0,12" FontSize="12">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Style.Triggers>
                            <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <DockPanel LastChildFill="False">
                <Button Content="Сохранить" DockPanel.Dock="Right" Style="{StaticResource Primary}" IsDefault="True" Click="Save_Click" MinWidth="130"/>
                <Button Content="Отмена" DockPanel.Dock="Right" Style="{StaticResource Ghost}" IsCancel="True" Click="Cancel_Click"/>
                <Button Content="Рекомендуемые значения" DockPanel.Dock="Left" Style="{StaticResource Ghost}" Click="Defaults_Click" Margin="0"
                        ToolTip="Поставить во все поля рекомендуемые значения. Сохранятся только после «Сохранить»"/>
            </DockPanel>
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="BodyScroll" VerticalScrollBarVisibility="Auto" MaxHeight="620" Padding="0,0,10,0">
            <StackPanel>
                <!-- Проверка серверов -->
                <TextBlock Text="ПРОВЕРКА СЕРВЕРОВ" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Эталонный DoH" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="RefDoh" Style="{StaticResource FieldBox}"/>
                        <TextBlock Text="Сравнение с ним показывает, подменяет ли сервер адреса ИИ. Адрес начинается с https://" Style="{StaticResource FieldHint}"/>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Таймаут проверки, сек" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TimeoutBox" Style="{StaticResource FieldBox}"/>
                                <TextBlock Text="от 2 до 30. Рекомендуем 6" Style="{StaticResource FieldHint}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Проверок одновременно" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="ParallelBox" Style="{StaticResource FieldBox}"/>
                                <TextBlock Text="от 1 до 64. Рекомендуем 24: больше быстрее, но выше нагрузка на сеть" Style="{StaticResource FieldHint}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Обновлять пинг, мин" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="PingBox" Style="{StaticResource FieldBox}"/>
                                <TextBlock Text="от 1 до 60. Рекомендуем 10. Таблица, шапка и трей" Style="{StaticResource FieldHint}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Трей и сторож -->
                <TextBlock Text="ТРЕЙ И СТОРОЖ" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <CheckBox x:Name="CloseToTrayBox" Content="Крестик прячет программу в трей (рекомендуем)"/>
                        <TextBlock Text="Подключение продолжает работать, программа открывается из трея" Style="{StaticResource FieldHint}" Margin="26,4,0,0"/>
                        <CheckBox x:Name="CheckUpdatesBox" Content="Проверять новую версию в фоне (рекомендуем)" Margin="0,12,0,0"/>
                        <TextBlock Text="При запуске и раз в 6 часов. Программа покажет, что вышло нового, а обновится по кнопке «Обновить» и сама перезапустится" Style="{StaticResource FieldHint}" Margin="26,4,0,0"/>
                        <CheckBox x:Name="AutoStartBox" Content="Запускать вместе с Windows (рекомендуем)" Margin="0,12,0,0"/>
                        <TextBlock Text="Программа стартует в трее без прав администратора. Если после загрузки DNS оказался сброшен, Windows спросит права, чтобы вернуть подключение" Style="{StaticResource FieldHint}" Margin="26,4,0,0"/>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Проверка сервисов в трее, мин" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TrayMinutesBox" Style="{StaticResource FieldBox}"/>
                                <TextBlock Text="от 1 до 60. Рекомендуем 5. Также при запуске и подключении" Style="{StaticResource FieldHint}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Сторож DNS, сек" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="WatchdogBox" Style="{StaticResource FieldBox}"/>
                                <TextBlock Text="от 15 до 600. Рекомендуем 60. Работает, пока подключено" Style="{StaticResource FieldHint}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Свои цвета интерфейса (SettingsColors.cs) -->
                <TextBlock Text="ЦВЕТА ИНТЕРФЕЙСА" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,18">
                    <StackPanel x:Name="ColorsHost"/>
                </Border>

                <!-- Данные и о программе -->
                <TextBlock Text="ДВА DNS (ЭКСПЕРИМЕНТ)" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock x:Name="SplitStatus" TextWrapping="Wrap" FontWeight="SemiBold"/>
                        <TextBlock Text="Общий DNS для всего интернета и Smart DNS только для ChatGPT, Claude и Gemini. Домены ИИ Windows отправляет в Smart DNS по своим правилам, остальное идет через общий DNS"
                                   Style="{StaticResource FieldHint}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <Button Content="Настроить два DNS" Click="SplitDns_Click" Style="{StaticResource Strong}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="ДАННЫЕ И О ПРОГРАММЕ" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <TextBlock x:Name="VersionText" Text="CHIMERION" FontWeight="SemiBold"/>
                        <TextBlock Text="Папка данных" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                        <Border Background="{DynamicResource Surface2}" CornerRadius="8" Padding="12,9" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                            <TextBlock x:Name="DataPathText" TextWrapping="Wrap" FontSize="12" FontFamily="Cascadia Mono, Consolas"/>
                        </Border>
                        <TextBlock Text="Здесь лежат settings.json, servers.json, журнал ошибок и резервная копия DNS. Не передавайте эти файлы другим: в settings.json могут быть Cookie."
                                   Style="{StaticResource FieldHint}" Margin="0,8,0,0"/>
                        <Button Content="Открыть папку данных" Click="OpenData_Click" Style="{StaticResource Ghost}"
                                HorizontalAlignment="Left" Margin="-18,10,0,0"/>
                        <StackPanel x:Name="RollbackPanel" Visibility="Collapsed" Margin="0,8,0,0">
                            <TextBlock x:Name="RollbackHint" Style="{StaticResource FieldHint}" TextWrapping="Wrap"/>
                            <Button x:Name="RollbackButton" Click="Rollback_Click" Style="{StaticResource Ghost}" HorizontalAlignment="Left" Margin="-18,6,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
