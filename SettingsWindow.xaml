<Window x:Class="Dnex.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="Настройки" FontSize="20" FontWeight="SemiBold"
                   FontFamily="{StaticResource DisplayFont}"/>
        <TextBlock Text="Изменения применяются после «Сохранить». Файл настроек: settings.json в папке данных."
                   Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,16"/>

        <!-- Проверка серверов -->
        <TextBlock Text="ПРОВЕРКА СЕРВЕРОВ" Style="{StaticResource Label}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <Border Style="{StaticResource Card}" Padding="16">
            <StackPanel>
                <TextBlock Text="Эталонный DoH для сравнения: подменяет ли сервер адреса ИИ" Style="{StaticResource Label}"/>
                <TextBox x:Name="RefDoh" Margin="0,4,0,4"/>
                <TextBlock Text="Адрес должен начинаться с https://" Style="{StaticResource Label}" FontSize="11" Margin="0,0,0,14"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Таймаут проверки, сек" Style="{StaticResource Label}"/>
                        <TextBox x:Name="TimeoutBox" Margin="0,4,0,0"/>
                        <TextBlock Text="от 2 до 30" Style="{StaticResource Label}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Проверок одновременно" Style="{StaticResource Label}"/>
                        <TextBox x:Name="ParallelBox" Margin="0,4,0,0"/>
                        <TextBlock Text="от 1 до 64. Больше значит быстрее, но выше нагрузка на сеть" Style="{StaticResource Label}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Трей и сторож -->
        <TextBlock Text="ТРЕЙ И СТОРОЖ" Style="{StaticResource Label}" FontSize="11" FontWeight="SemiBold" Margin="0,18,0,6"/>
        <Border Style="{StaticResource Card}" Padding="16">
            <StackPanel>
                <CheckBox x:Name="CloseToTrayBox" Content="Крестик прячет программу в трей (подключение продолжает работать)"/>
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Проверка ИИ-сервисов в трее, мин" Style="{StaticResource Label}"/>
                        <TextBox x:Name="TrayMinutesBox" Margin="0,4,0,0"/>
                        <TextBlock Text="от 1 до 60. Также при запуске и подключении" Style="{StaticResource Label}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Сторож DNS, сек" Style="{StaticResource Label}"/>
                        <TextBox x:Name="WatchdogBox" Margin="0,4,0,0"/>
                        <TextBlock Text="от 15 до 600. Работает, пока подключено" Style="{StaticResource Label}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Данные и о программе -->
        <TextBlock Text="ДАННЫЕ И О ПРОГРАММЕ" Style="{StaticResource Label}" FontSize="11" FontWeight="SemiBold" Margin="0,18,0,6"/>
        <Border Style="{StaticResource Card}" Padding="16">
            <StackPanel>
                <TextBlock x:Name="VersionText" Text="DNEX"/>
                <TextBlock Text="Папка данных" Style="{StaticResource Label}" Margin="0,10,0,2"/>
                <TextBlock x:Name="DataPathText" TextWrapping="Wrap" FontSize="12" FontFamily="Consolas, Segoe UI"/>
                <TextBlock Text="Здесь лежат settings.json, servers.json, журнал ошибок и резервная копия DNS. Не передавайте эти файлы другим: в settings.json могут быть Cookie."
                           Style="{StaticResource Label}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <Button Content="Открыть папку данных" Click="OpenData_Click" Style="{StaticResource Ghost}"
                        HorizontalAlignment="Left" Margin="-18,10,0,0"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource Bad}" TextWrapping="Wrap" Margin="0,12,0,0"/>

        <DockPanel Margin="0,16,0,0" LastChildFill="False">
            <Button Content="Отмена" DockPanel.Dock="Right" Style="{StaticResource Ghost}" IsCancel="True" Click="Cancel_Click"/>
            <Button Content="Сохранить" DockPanel.Dock="Right" Style="{StaticResource Primary}" IsDefault="True" Click="Save_Click"/>
        </DockPanel>
    </StackPanel>
</Window>
