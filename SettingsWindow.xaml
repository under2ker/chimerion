<Window x:Class="Dnex.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки" Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Window.Resources>
        <!-- Заголовок раздела: маленькие заглавные буквы, приглушенный цвет -->
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,20,0,8"/>
        </Style>
        <!-- Подпись поля над полем ввода -->
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <!-- Пояснение под полем -->
        <Style x:Key="FieldHint" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- Поле ввода одинаковой высоты -->
        <Style x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="28,24,28,20">
        <!-- Шапка: логотип и название -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <Image Source="/Assets/dnex-logo.png" Width="40" Height="40" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Настройки" FontSize="20" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"/>
                <TextBlock Text="Изменения применяются после «Сохранить»" Style="{StaticResource Label}" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Нижняя панель: ошибка слева, кнопки справа -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,16,0,0">
            <DockPanel LastChildFill="False">
                <Button Content="Сохранить" DockPanel.Dock="Right" Style="{StaticResource Primary}" IsDefault="True" Click="Save_Click" MinWidth="130"/>
                <Button Content="Отмена" DockPanel.Dock="Right" Style="{StaticResource Ghost}" IsCancel="True" Click="Cancel_Click"/>
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource Bad}" TextWrapping="Wrap" VerticalAlignment="Center"
                           MaxWidth="300" DockPanel.Dock="Left"/>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="620" Padding="0,0,10,0">
            <StackPanel>
                <!-- Проверка серверов -->
                <TextBlock Text="ПРОВЕРКА СЕРВЕРОВ" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Эталонный DoH" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="RefDoh" Style="{StaticResource FieldBox}"/>
                        <TextBlock Text="Сравнение с ним показывает, подменяет ли сервер адреса ИИ. Адрес начинается с https://" Style="{StaticResource FieldHint}"/>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Таймаут проверки, сек" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TimeoutBox" Style="{StaticResource FieldBox}"/>
                                <TextBlock Text="от 2 до 30" Style="{StaticResource FieldHint}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Проверок одновременно" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="ParallelBox" Style="{StaticResource FieldBox}"/>
                                <TextBlock Text="от 1 до 64. Больше значит быстрее, но выше нагрузка на сеть" Style="{StaticResource FieldHint}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Обновлять пинг, мин" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="PingBox" Style="{StaticResource FieldBox}"/>
                                <TextBlock Text="от 1 до 60. Таблица, шапка и трей" Style="{StaticResource FieldHint}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Трей и сторож -->
                <TextBlock Text="ТРЕЙ И СТОРОЖ" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <CheckBox x:Name="CloseToTrayBox" Content="Крестик прячет программу в трей"/>
                        <TextBlock Text="Подключение продолжает работать, программа открывается из трея" Style="{StaticResource FieldHint}" Margin="26,4,0,0"/>
                        <CheckBox x:Name="CheckUpdatesBox" Content="Проверять новую версию при запуске" Margin="0,12,0,0"/>
                        <TextBlock Text="Только проверка и уведомление: программа не скачивает и не заменяет файлы сама" Style="{StaticResource FieldHint}" Margin="26,4,0,0"/>
                        <CheckBox x:Name="AutoStartBox" Content="Запускать вместе с Windows" Margin="0,12,0,0"/>
                        <TextBlock Text="Программа стартует в трее с правами администратора и сразу возвращает DNS, который был включен. Права Windows спросит один раз, при включении" Style="{StaticResource FieldHint}" Margin="26,4,0,0"/>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Проверка сервисов в трее, мин" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TrayMinutesBox" Style="{StaticResource FieldBox}"/>
                                <TextBlock Text="от 1 до 60. Также при запуске и подключении" Style="{StaticResource FieldHint}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Сторож DNS, сек" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="WatchdogBox" Style="{StaticResource FieldBox}"/>
                                <TextBlock Text="от 15 до 600. Работает, пока подключено" Style="{StaticResource FieldHint}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Данные и о программе -->
                <TextBlock Text="ДАННЫЕ И О ПРОГРАММЕ" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <TextBlock x:Name="VersionText" Text="DNEX" FontWeight="SemiBold"/>
                        <TextBlock Text="Папка данных" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                        <Border Background="{StaticResource Surface2}" CornerRadius="8" Padding="12,9" BorderBrush="{StaticResource Border}" BorderThickness="1">
                            <TextBlock x:Name="DataPathText" TextWrapping="Wrap" FontSize="12" FontFamily="Cascadia Mono, Consolas"/>
                        </Border>
                        <TextBlock Text="Здесь лежат settings.json, servers.json, журнал ошибок и резервная копия DNS. Не передавайте эти файлы другим: в settings.json могут быть Cookie."
                                   Style="{StaticResource FieldHint}" Margin="0,8,0,0"/>
                        <Button Content="Открыть папку данных" Click="OpenData_Click" Style="{StaticResource Ghost}"
                                HorizontalAlignment="Left" Margin="-18,10,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
