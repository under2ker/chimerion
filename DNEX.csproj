<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DNEX</AssemblyName>
    <RootNamespace>Dnex</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.12</Version>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationIcon>Assets\dnex.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\dnex-logo.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Тесты живут отдельно и не входят в программу -->
    <Compile Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Только NotifyIcon для трея; WinForms не импортируется глобально, имена полные -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
