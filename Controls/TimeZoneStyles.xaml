<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Dnex.Controls">
    <Style x:Key="TimeZoneScope" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="card" Padding="12,9,12,9" MinHeight="64" CornerRadius="11" BorderThickness="1"
                            BorderBrush="{DynamicResource Border}" Background="{DynamicResource Surface}">
                        <Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                            <Border x:Name="focus" Margin="-9,-6" BorderThickness="1" CornerRadius="8"
                                    BorderBrush="{DynamicResource Focus}" Visibility="Collapsed" IsHitTestVisible="False"/>
                            <controls:Icon x:Name="selected" Kind="circle-check" Size="15" Animated="False"
                                           Foreground="{DynamicResource Accent}" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="card" Property="Background" Value="{DynamicResource SurfaceHover}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="focus" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="card" Property="Background" Value="{DynamicResource AccentSoft}"/>
                            <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="selected" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TimeZoneCountryPicker" TargetType="ComboBox">
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="MaxDropDownHeight" Value="330"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="ToolTip" Value="{Binding SelectedItem.Name, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="AutomationProperties.AutomationId" Value="{Binding Code}"/>
                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="item" Background="Transparent" Padding="9,6" CornerRadius="6">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="item" Property="Background" Value="{DynamicResource SurfaceHover}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="item" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="field" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource ControlBorder}"
                                BorderThickness="1" CornerRadius="7"/>
                        <ToggleButton Focusable="False" ClickMode="Press" Cursor="Hand"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <TextBlock Text="{Binding SelectedItem.Name, RelativeSource={RelativeSource TemplatedParent}}" TextTrimming="CharacterEllipsis"
                                   Margin="10,0,28,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <controls:Icon Kind="chevron-down" Size="12" Margin="0,0,10,0" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Muted}" IsHitTestVisible="False"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade" VerticalOffset="4">
                            <Border Background="{DynamicResource MenuBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                    CornerRadius="8" Padding="4" Width="258" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="field" Property="Background" Value="{DynamicResource SurfaceHover}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="field" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="TimeZoneItem" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
        <Setter Property="AutomationProperties.AutomationId" Value="{Binding Id}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,1,4,1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="row" Padding="9,4" Height="44" CornerRadius="7" BorderThickness="1"
                            BorderBrush="Transparent" Background="Transparent">
                        <Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                            <Border x:Name="focus" Margin="-6,-3" BorderThickness="1" CornerRadius="4"
                                    BorderBrush="{DynamicResource Focus}" Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="row" Property="Background" Value="{DynamicResource SurfaceHover}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="focus" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="row" Property="Background" Value="{DynamicResource AccentSoft}"/>
                            <Setter TargetName="row" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="TimeZoneRow">
        <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding Offset}" Foreground="{DynamicResource Muted}"
                       FontSize="12" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" Margin="9,0,0,0"/>
            <StackPanel VerticalAlignment="Center" ToolTip="{Binding Label}">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Country}" Foreground="{DynamicResource Muted}" FontSize="11.5" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Country}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DockPanel>
    </DataTemplate>
</ResourceDictionary>
