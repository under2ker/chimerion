<Application x:Class="Dnex.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Dnex.Controls"
             DispatcherUnhandledException="OnUnhandled">
    <Application.Resources>

        <!-- ===== Палитра ===== -->
        <Color x:Key="BgColor">#0F1012</Color>
        <SolidColorBrush x:Key="Bg" Color="#0F1012"/>
        <SolidColorBrush x:Key="Surface" Color="#17191C"/>
        <SolidColorBrush x:Key="Surface2" Color="#1F2125"/>
        <SolidColorBrush x:Key="SurfaceHover" Color="#272A2F"/>
        <SolidColorBrush x:Key="Border" Color="#2B2E33"/>
        <SolidColorBrush x:Key="Text" Color="#F3F4F1"/>
        <SolidColorBrush x:Key="Muted" Color="#A9AEB5"/>
        <SolidColorBrush x:Key="Accent" Color="#C5F23A"/>
        <SolidColorBrush x:Key="AccentHover" Color="#D3F566"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#2A3413"/>
        <SolidColorBrush x:Key="Ok" Color="#3DD68C"/>
        <SolidColorBrush x:Key="Warn" Color="#F5B941"/>
        <SolidColorBrush x:Key="Bad" Color="#F2626E"/>
        <SolidColorBrush x:Key="Idle" Color="#5C6373"/>
        <SolidColorBrush x:Key="Focus" Color="#DCF781"/>
        <SolidColorBrush x:Key="OkSoft" Color="#13281E"/>
        <SolidColorBrush x:Key="Lime" Color="#C5F23A"/>
        <!-- Мягкие подложки статусов: значок в шапке окна, метки, плашки -->
        <SolidColorBrush x:Key="LimeSoft" Color="#273110"/>
        <SolidColorBrush x:Key="WarnSoft" Color="#3A2D12"/>
        <SolidColorBrush x:Key="BadSoft" Color="#3A171C"/>
        <SolidColorBrush x:Key="InfoSoft" Color="#252D14"/>
        <!-- Полоса заголовка главного окна и бегунок прокрутки -->
        <SolidColorBrush x:Key="Chrome" Color="#0B0C0D"/>
        <SolidColorBrush x:Key="ScrollThumb" Color="#3A3E44"/>
        <SolidColorBrush x:Key="ScrollThumbHover" Color="#4C5158"/>
        <!-- Плашки статуса в таблице и карточках сервисов (ярче мягких подложек, чтобы читались на строке) -->
        <SolidColorBrush x:Key="ChipOk" Color="#173A2A"/>
        <SolidColorBrush x:Key="ChipWarn" Color="#3A2F17"/>
        <SolidColorBrush x:Key="ChipBad" Color="#3A1C20"/>
        <SolidColorBrush x:Key="ChipLime" Color="#2B3D12"/>
        <!-- Выделение строк, линии таблицы, обводка акцентных элементов -->
        <SolidColorBrush x:Key="Selection" Color="#2B3816"/>
        <LinearGradientBrush x:Key="ConnectedRow" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#55C5F23A" Offset="0"/>
            <GradientStop Color="#00C5F23A" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ConnectedRowSelected" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#80C5F23A" Offset="0"/>
            <GradientStop Color="#FF2B3816" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="SelectionInactive" Color="#252F15"/>
        <SolidColorBrush x:Key="GridLine" Color="#212428"/>
        <SolidColorBrush x:Key="AccentBorder" Color="#86A231"/>
        <SolidColorBrush x:Key="ControlBorder" Color="#4C5158"/>
        <!-- Настраиваемые в «Настройки» → «Цвета» (ThemeColors). Ссылки на них только DynamicResource, чтобы смена
             цвета сразу доходила до всех окон. On* — текст поверх заливки, подбирается по контрасту -->
        <SolidColorBrush x:Key="OnAccentButton" Color="#111214"/>
        <SolidColorBrush x:Key="StrongButton" Color="#23262A"/>
        <SolidColorBrush x:Key="OnStrongButton" Color="White"/>
        <!-- Подсветка кнопки при наведении: белая на темной теме, черная на светлой (непрозрачность задает шаблон) -->
        <SolidColorBrush x:Key="HoverOverlay" Color="White"/>
        <SolidColorBrush x:Key="ToggleOn" Color="#C5F23A"/>
        <SolidColorBrush x:Key="OnToggle" Color="#111214"/>
        <SolidColorBrush x:Key="MenuBg" Color="#1C1E21"/>
        <SolidColorBrush x:Key="MenuHover" Color="#2A2D31"/>
        <!-- Знак CHIMERION: две первые полосы (белые в стандартной схеме, цвета акцента в своей) и третья оливковая -->
        <SolidColorBrush x:Key="LogoStripe" Color="#F5F5F0"/>
        <SolidColorBrush x:Key="LogoTail" Color="#B5B29C"/>
        <!-- Заливка кнопок с белым текстом: контраст не ниже 4.5:1 (основной и красный цвет чуть темнее) -->
        <SolidColorBrush x:Key="AccentButton" Color="#C5F23A"/>
        <SolidColorBrush x:Key="BadButton" Color="#C23B47"/>
        <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>

        <!-- Кольцо фокуса для навигации с клавиатуры: без него фокус на кнопках не виден -->
        <Style x:Key="FocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource Focus}" Margin="-3"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        </Style>

        <!-- ===== Кнопки ===== -->
        <Style TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <!-- Отступы с запасом: иначе текст касается края подсветки при наведении -->
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <Grid>
                                <!-- Подсветка при наведении плавно нарастает поверх фона, текст не меняется.
                                     Отступы у текста, а не у рамки: иначе подсветка не покрывает поля вокруг слова -->
                                <Border x:Name="hov" Background="{DynamicResource HoverOverlay}" CornerRadius="7" Opacity="0"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
                                    <!-- Текст кнопки цвета самой кнопки: иначе общий стиль TextBlock (белый) перебивал его,
                                         и на лаймовой основной кнопке белая надпись не читалась -->
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"/>
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Opacity" To="0.08" Duration="0:0:0.15"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource AccentButton}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentButton}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentButton}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <Grid>
                                <Border x:Name="hov" Background="{DynamicResource HoverOverlay}" CornerRadius="7" Opacity="0"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
                                    <!-- Текст кнопки цвета самой кнопки: иначе общий стиль TextBlock (белый) перебивал его,
                                         и на лаймовой основной кнопке белая надпись не читалась -->
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"/>
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Opacity" To="0.1" Duration="0:0:0.15"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        </Style>

        <!-- Важное действие рядом с основным: светлая заливка, заметная синяя рамка и белый текст,
             чтобы кнопка не терялась на темной карточке -->
        <Style x:Key="Strong" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource StrongButton}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorder}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnStrongButton}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{DynamicResource Bad}"/>
        </Style>

        <!-- ===== Поля ввода (подсказка через Tag) ===== -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <TextBlock x:Name="hint" Text="{TemplateBinding Tag}" Foreground="{DynamicResource Muted}"
                                           Margin="{TemplateBinding Padding}" Padding="2,0,0,0" VerticalAlignment="Center"
                                           IsHitTestVisible="False" Visibility="Collapsed"/>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="hint" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

