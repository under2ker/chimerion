<Window x:Class="Dnex.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Dnex.Controls"
        Title="DNEX" Icon="/Assets/dnex-logo.png" Height="1040" Width="1600"
        MinHeight="560" MinWidth="1000" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        WindowStyle="None">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- Кнопки управления окном: свернуть, развернуть, закрыть -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Surface2}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionClose" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C23B47"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Своя полоса заголовка: логотип, кнопка проверки обновления и кнопки окна -->
        <Grid x:Name="TitleBar" DockPanel.Dock="Top" Height="40" Background="#101217">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                <Image Source="/Assets/dnex-logo.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="DNEX" Margin="8,0,0,0" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Grid.Column="1" x:Name="CheckUpdateButton" Content="Проверить обновление" Click="CheckUpdate_Click"
                    Style="{StaticResource Ghost}" Padding="12,4" Margin="0,0,8,0" FontSize="12" VerticalAlignment="Center"
                    WindowChrome.IsHitTestVisibleInChrome="True"
                    ToolTip="Проверить, есть ли новая версия DNEX на GitHub"/>
            <Button Grid.Column="2" Content="–" Style="{StaticResource CaptionButton}" Click="Minimize_Click"
                    WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Свернуть"/>
            <Button Grid.Column="3" x:Name="MaxButton" Content="☐" Style="{StaticResource CaptionButton}" Click="MaxRestore_Click"
                    WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Развернуть"/>
            <Button Grid.Column="4" Content="✕" Style="{StaticResource CaptionClose}" Click="Close_Click"
                    WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Закрыть"/>
        </Grid>

    <Grid x:Name="RootGrid" Margin="20,8,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- шапка -->
            <RowDefinition Height="Auto"/>  <!-- проверка подключения -->
            <RowDefinition Height="Auto"/>  <!-- поиск и действия -->
            <RowDefinition Height="*"/>     <!-- таблица -->
            <RowDefinition Height="Auto"/>  <!-- низ -->
        </Grid.RowDefinitions>

        <!-- ================= ШАПКА ================= -->
        <Grid x:Name="HeaderGrid" Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- вторая строка — кнопка подключения, видна только в компактном виде -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/> <!-- статистика в компактном виде -->
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/Assets/dnex-logo.png" Width="40" Height="40" Stretch="Uniform" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="AppTitle" Text="DNEX" FontSize="17" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"/>
                    <TextBlock x:Name="Subtitle" Text="Smart DNS для ИИ" Style="{StaticResource Label}"/>
                </StackPanel>

                <!-- Состояние подключения -->
                <Border x:Name="ConnPill" Margin="28,0,0,0" Padding="14,8" CornerRadius="10"
                        Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ConnDot" Width="9" Height="9" Fill="{StaticResource Idle}" VerticalAlignment="Center"/>
                        <StackPanel Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Image x:Name="ConnFlag" Width="18" Height="13" Margin="0,0,8,0" Stretch="Uniform"
                                       VerticalAlignment="Center" Visibility="Collapsed"/>
                                <TextBlock x:Name="ConnText" Text="Не подключено" FontWeight="SemiBold"
                                           MaxWidth="300" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock x:Name="ConnLocation" Style="{StaticResource Label}" FontSize="12"
                                       MaxWidth="300" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                            <TextBlock x:Name="DnsLine" Style="{StaticResource Label}" FontSize="12">
                                <Run Text="DNS системы"/>
                                <Run x:Name="CurrentDns" Text="…"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- Статистика активного подключения: справа от карточки, видна пока подключено.
                 Колонка растягивается, поэтому на узком окне блоки переносятся, а кнопки не уезжают. -->
            <WrapPanel x:Name="HeaderStats" Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                <StackPanel Margin="0,0,14,6">
                    <TextBlock Text="Пинг" Style="{StaticResource Label}" FontSize="11"/>
                    <StackPanel Orientation="Horizontal">
                        <controls:PingBars x:Name="StatPingBars" Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatPing" Text="—" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
                <Rectangle Width="1" Height="30" Fill="{StaticResource Border}" Margin="0,2,14,8"/>
                <StackPanel Margin="0,0,14,6">
                    <TextBlock Text="Стабильность" Style="{StaticResource Label}" FontSize="11"/>
                    <TextBlock x:Name="StatStab" Text="—" FontSize="14" FontWeight="SemiBold"/>
                </StackPanel>
                <Rectangle Width="1" Height="30" Fill="{StaticResource Border}" Margin="0,2,14,8"/>
                <StackPanel Margin="0,0,0,6">
                    <TextBlock Text="ИИ доступно" Style="{StaticResource Label}" FontSize="11"/>
                    <TextBlock x:Name="StatServices" Text="—" FontSize="14" FontWeight="SemiBold"/>
                </StackPanel>
                <!-- Обновить подключенный сервер: та же проверка, что и кнопка в строке таблицы -->
                <Button x:Name="ActiveRefresh" Style="{StaticResource RowRefresh}" Click="ActiveRefresh_Click"
                        Margin="16,0,0,6" VerticalAlignment="Bottom"
                        ToolTip="Обновить подключенный сервер: проверка ИИ-сервисов и пинг"
                        AutomationProperties.Name="Обновить подключенный сервер">
                    <Path x:Name="ActiveRefreshIcon" Style="{StaticResource RefreshGlyph}" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform><RotateTransform/></Path.RenderTransform>
                    </Path>
                </Button>
            </WrapPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ModeButton" Content="Компактно" Click="Mode_Click" Style="{StaticResource Ghost}"
                        ToolTip="Компактный / полный вид"/>
                <Button x:Name="SettingsButton" Content="Настройки" Click="Settings_Click" Style="{StaticResource Ghost}"
                        ToolTip="Настройки программы"/>
                <Button x:Name="DataButton" Content="Данные" Click="OpenData_Click" Style="{StaticResource Ghost}"
                        ToolTip="Открыть папку с настройками и списком"/>
                <Rectangle x:Name="HeaderSep" Width="1" Height="24" Fill="{StaticResource Border}" Margin="12,0"/>
                <StackPanel x:Name="ApplyActions" Orientation="Horizontal">
                    <CheckBox x:Name="Watchdog" Content="Следить" IsChecked="True" Margin="0,0,14,0"
                              ToolTip="Пока подключено, DNS проверяется периодически (интервал задается в настройках). После трех неудач подряд подключение безопасно отключается"/>
                    <Button x:Name="SwitchButton" Content="Переключить сюда" Click="Switch_Click" Margin="0,0,8,0"
                            Padding="16,9" Visibility="Collapsed"
                            ToolTip="Подключиться к выбранному серверу вместо текущего"/>
                    <Button x:Name="ConnectButton" Content="Подключить" Click="Main_Click" Style="{StaticResource Primary}"
                            Padding="22,9" Margin="0" MinWidth="140"
                            ToolTip="Подключиться к выбранному серверу. По умолчанию выбирается лучший"/>
                </StackPanel>
            </StackPanel>
            <!-- Компактный вид: одна крупная кнопка подключения и краткий статус сервисов -->
            <Button x:Name="CompactConnect" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0" Padding="16,9"
                    Style="{StaticResource Primary}" Click="Main_Click" Visibility="Collapsed"
                    ToolTip="Подключиться к выбранному серверу. По умолчанию выбирается лучший"/>
        </Grid>

        <!-- ================= ПРОВЕРКА ПОДКЛЮЧЕНИЯ И ЛУЧШИЕ ПО СТАБИЛЬНОСТИ ================= -->
        <!-- Две рамки одной высоты. Правая скрыта в компактном виде и в узком окне (см. ApplyResponsive) -->
        <Grid x:Name="CheckRow" Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="VerdictCard" Grid.Column="0" Style="{StaticResource Card}" Padding="16,12">
                <StackPanel>
                    <DockPanel x:Name="VerdictHeader" LastChildFill="False">
                        <TextBlock Text="Проверка подключения" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                        <Border x:Name="VerdictBadge" Margin="12,0,0,0" Padding="10,3" CornerRadius="6"
                                Background="{StaticResource Surface2}" VerticalAlignment="Center">
                            <TextBlock x:Name="VerdictText" Text="еще не проверялось" FontSize="12" Foreground="{StaticResource Muted}"/>
                        </Border>
                        <Button x:Name="CompareToggle" Content="Скрыть" Click="CompareToggle_Click" Style="{StaticResource Ghost}"
                                DockPanel.Dock="Right"/>
                        <Button x:Name="ProbeButton" Content="Проверить сейчас" Click="Probe_Click" DockPanel.Dock="Right" Style="{StaticResource Strong}"
                                ToolTip="Внешний IP, DNS, адреса и доступность ИИ-сервисов прямо сейчас"/>
                    </DockPanel>
                    <StackPanel x:Name="CompareGrid" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
            <Border x:Name="TopCard" Grid.Column="1" Width="480" Style="{StaticResource Card}" Padding="16,12" Margin="12,0,0,0">
                <StackPanel x:Name="TopRows"/>
            </Border>
        </Grid>

        <!-- ================= ПОИСК И ДЕЙСТВИЯ ================= -->
        <DockPanel x:Name="ToolbarCard" Grid.Row="2" Margin="0,0,0,12" LastChildFill="False">
            <TextBox x:Name="SearchBox" TextChanged="Filter_Changed" Width="300" Tag="Поиск: имя, IP, источник"/>

            <Border Margin="10,0,0,0" Padding="3" CornerRadius="9" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Border}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="WorkingTab" Style="{StaticResource Tab}" GroupName="f" Tag="5" IsChecked="True" Checked="FilterTab_Checked" Content="Рабочие"/>
                    <RadioButton x:Name="AllTab" Style="{StaticResource Tab}" GroupName="f" Tag="0" Checked="FilterTab_Checked" Content="Все"/>
                    <RadioButton x:Name="FavTab" Style="{StaticResource Tab}" GroupName="f" Tag="6" Checked="FilterTab_Checked" Content="Избранные"/>
                </StackPanel>
            </Border>

            <StackPanel x:Name="ListActions" Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Перепроверить" Click="CheckAll_Click" Style="{StaticResource Strong}"
                        ToolTip="Еще раз проверить все серверы в списке"/>
                <Button Content="Найти новые серверы" Click="Fetch_Click" Style="{StaticResource Primary}"
                        ToolTip="Поиск по источникам и в интернете; найденные проверяются автоматически, нерабочие удаляются"/>
            </StackPanel>
            <Button x:Name="StopButton" Content="Стоп" Click="Stop_Click" Style="{StaticResource Danger}"
                    DockPanel.Dock="Right" Visibility="Collapsed"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock x:Name="ProgressText" Style="{StaticResource Label}" VerticalAlignment="Center"
                           MaxWidth="380" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                <ProgressBar x:Name="WorkBar" Width="140" Visibility="Collapsed" AutomationProperties.Name="Прогресс работы"/>
            </StackPanel>
        </DockPanel>

        <!-- ================= ТАБЛИЦА ================= -->
        <Border x:Name="TableCard" Grid.Row="3" Style="{StaticResource Card}" Padding="0" SizeChanged="TableCard_SizeChanged">
            <DockPanel>
                <!-- Выбранный сервер -->
                <Border x:Name="SelectionBar" DockPanel.Dock="Top" Padding="16,10"
                        BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <TextBlock x:Name="StatsText" DockPanel.Dock="Right" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <Ellipse x:Name="SelectionIcon" Width="10" Height="10" Fill="{StaticResource Idle}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="SelectionTitle" Text="Сервер не выбран" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                                <!-- Откуда взят сервер: сайт и путь на нем. Щелчок открывает страницу -->
                                <TextBlock x:Name="SelectionSource" Margin="14,1,0,0" FontSize="12" VerticalAlignment="Center" Visibility="Collapsed"
                                           TextTrimming="CharacterEllipsis" MaxWidth="640" MouseLeftButtonUp="SelectionSource_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="SelectionDetails" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis"
                                       Text="Выберите сервер. Двойной щелчок или Enter подключает к нему, правая кнопка открывает действия."/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <DataGrid x:Name="ServerGrid" AutomationProperties.Name="Список серверов" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          SelectionMode="Extended" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#222630" Background="Transparent" BorderThickness="0"
                          Foreground="{StaticResource Text}" Margin="0,0,0,4"
                          HorizontalScrollBarVisibility="Disabled" CanUserResizeRows="False"
                          SelectionChanged="Grid_SelectionChanged" MouseDoubleClick="Grid_DoubleClick"
                          PreviewMouseLeftButtonDown="ServerGrid_PreviewMouseLeftButtonDown"
                          PreviewKeyDown="Grid_KeyDown">
                    <DataGrid.ContextMenu>
                        <ContextMenu Opened="RowMenu_Opened">
                            <MenuItem x:Name="MenuConnect" Header="Подключить" Click="MenuConnect_Click" InputGestureText="Enter"/>
                            <MenuItem Header="Проверить" Click="CheckSelected_Click"/>
                            <MenuItem x:Name="MenuFav" Header="В избранное" Click="MenuFav_Click"/>
                            <Separator/>
                            <MenuItem x:Name="MenuSource" Header="Открыть источник" Click="MenuSource_Click"/>
                            <MenuItem Header="Копировать адрес" Click="MenuCopy_Click" InputGestureText="Ctrl+C"/>
                            <Separator/>
                            <MenuItem Header="Удалить" Click="Delete_Click" InputGestureText="Del"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#263F66"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#203A66"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
                    </DataGrid.Resources>
                    <DataGrid.Columns>

                        <!-- Статус -->
                        <!-- Обновление одного сервера: полная проверка строки -->
                        <!-- 52 px: кнопка 30 px плюс отступы ячейки 10 px с каждой стороны -->
                        <DataGridTemplateColumn x:Name="ColRefresh" Width="52" CanUserResize="False" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RowRefresh}" Click="RowRefresh_Click"
                                            ToolTip="Обновить этот сервер: проверка ИИ-сервисов и пинг"
                                            AutomationProperties.Name="Обновить сервер">
                                        <Path x:Name="icon" Style="{StaticResource RefreshGlyph}" RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform><RotateTransform/></Path.RenderTransform>
                                        </Path>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <!-- Пока сервер проверяется, значок крутится -->
                                        <DataTrigger Binding="{Binding Status}" Value="Checking">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="spin">
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetName="icon"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                         From="0" To="360" Duration="0:0:0.9"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="spin"/>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Избранное: звездочка. В компактном виде колонка скрыта, там действует меню строки -->
                        <DataGridTemplateColumn x:Name="ColFav" Width="40" CanUserResize="False" SortMemberPath="IsFavorite">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Click="Fav_Click" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0" Margin="0"
                                            MinHeight="0" Focusable="False" ToolTip="Добавить в избранное или убрать"
                                            AutomationProperties.Name="Избранное">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <TextBlock x:Name="star" Text="☆" FontSize="17" Foreground="{StaticResource Muted}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent"/>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                        <Setter TargetName="star" Property="Text" Value="★"/>
                                                        <Setter TargetName="star" Property="Foreground" Value="{StaticResource Warn}"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="star" Property="Foreground" Value="{StaticResource Warn}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn x:Name="ColStatus" Header="СТАТУС" Width="128" SortMemberPath="Rank">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid x:Name="stRoot" ClipToBounds="True">
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="dot" Width="8" Height="8" Fill="{StaticResource Idle}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="st" Text="{Binding StatusText}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <!-- Сервер, через который подключено: видно прямо в колонке статуса -->
                                            <Border x:Name="connBadge" Margin="18,3,0,0" Padding="6,0" CornerRadius="4" HorizontalAlignment="Left" Background="#2B3D12"
                                                    ToolTip="Подключение идет через этот сервер" Visibility="Collapsed">
                                                <TextBlock Text="подключен" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Lime}"/>
                                            </Border>
                                        </StackPanel>
                                        <!-- Бегущий блик: виден, пока сервер проверяется -->
                                        <Rectangle x:Name="sheen" Width="46" HorizontalAlignment="Left" Visibility="Collapsed" IsHitTestVisible="False">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#00FFFFFF" Offset="0"/>
                                                    <GradientStop Color="#40FFFFFF" Offset="0.5"/>
                                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                            <Rectangle.RenderTransform>
                                                <TranslateTransform x:Name="sheenT" X="-60"/>
                                            </Rectangle.RenderTransform>
                                        </Rectangle>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter TargetName="connBadge" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <!-- В узкой колонке текста нет места: только точка. Стоит после бейджа, поэтому побеждает -->
                                        <DataTrigger Binding="{Binding Tag, ElementName=ServerGrid}" Value="compact">
                                            <Setter TargetName="st" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="connBadge" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Ok">
                                            <Setter TargetName="dot" Property="Fill" Value="{StaticResource Ok}"/>
                                            <Setter TargetName="st" Property="Foreground" Value="{StaticResource Text}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Partial">
                                            <Setter TargetName="dot" Property="Fill" Value="{StaticResource Warn}"/>
                                            <Setter TargetName="st" Property="Foreground" Value="{StaticResource Text}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Fail">
                                            <Setter TargetName="dot" Property="Fill" Value="{StaticResource Bad}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Checking">
                                            <Setter TargetName="dot" Property="Fill" Value="{StaticResource Accent}"/>
                                            <Setter TargetName="sheen" Property="Visibility" Value="Visible"/>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="sweep">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="sheenT" Storyboard.TargetProperty="X"
                                                                         From="-60" To="150" Duration="0:0:1.3" RepeatBehavior="Forever"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="sweep"/>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                        <!-- В компактном окне при проверке без блика: анимация остается только у пинга -->
                                        <DataTrigger Binding="{Binding Tag, ElementName=ServerGrid}" Value="compact">
                                            <Setter TargetName="sheen" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Сервер: имя + адрес второй строкой -->
                        <DataGridTemplateColumn Header="СЕРВЕР" Width="2*" MinWidth="220" SortMemberPath="DisplayName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" ToolTip="{Binding DohUrl}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding ShortName}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                                            <Border x:Name="newBadge" Margin="8,0,0,0" Padding="5,0" CornerRadius="4" Background="#173A2A"
                                                    VerticalAlignment="Center" Visibility="Collapsed">
                                                <TextBlock Text="новый" FontSize="12" FontWeight="Normal" Foreground="{StaticResource Ok}"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding Address}" Style="{StaticResource Label}" FontWeight="Normal"
                                                       FontFamily="Cascadia Mono, Consolas" TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                                            <!-- Лучший по стабильности: для всех сразу или для отдельного ИИ (см. блок над таблицей) -->
                                            <Border x:Name="bestBadge" Margin="8,0,0,0" Padding="5,0" CornerRadius="4" Background="#2B3D12"
                                                    VerticalAlignment="Center" Visibility="Collapsed" ToolTip="Самая высокая стабильность по данным проверок">
                                                <TextBlock Text="{Binding BestFor}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Lime}"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsNew}" Value="True">
                                            <Setter TargetName="newBadge" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBest}" Value="True">
                                            <Setter TargetName="bestBadge" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <!-- В компактном окне бейджи не помещаются рядом с названием -->
                                        <DataTrigger Binding="{Binding Tag, ElementName=ServerGrid}" Value="compact">
                                            <Setter TargetName="newBadge" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="bestBadge" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Локация DNS-сервера: флаг страны и название места -->
                        <DataGridTemplateColumn x:Name="ColLocation" Header="ЛОКАЦИЯ" Width="330" MinWidth="160" SortMemberPath="Country">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding LocationTooltip}">
                                        <Image Source="{Binding Flag}" Width="20" Height="14" Margin="0,0,8,0" Stretch="Uniform" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding LocationCell}" Foreground="{StaticResource Muted}" FontWeight="Normal"
                                                   MaxWidth="290" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Text="⚠" Foreground="{StaticResource Warn}" Margin="6,0,0,0" VerticalAlignment="Center"
                                                   Visibility="{Binding HasLocationWarning, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Сервисы: плашки -->
                        <DataGridTemplateColumn x:Name="ColServices" Header="СЕРВИСЫ" Width="260" MinWidth="200" SortMemberPath="Summary">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding Chips}" ToolTip="{Binding Summary}" VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="chip" Style="{StaticResource Chip}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Source="{Binding Logo}" Width="12" Height="12" Margin="0,0,5,0" Stretch="Uniform" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="t" Text="{Binding Name}" FontSize="12" FontWeight="Normal" Foreground="{StaticResource Muted}"/>
                                                    </StackPanel>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="ok">
                                                        <Setter TargetName="chip" Property="Background" Value="#173A2A"/>
                                                        <Setter TargetName="t" Property="Foreground" Value="{StaticResource Ok}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="region">
                                                        <Setter TargetName="chip" Property="Background" Value="#3A2F17"/>
                                                        <Setter TargetName="t" Property="Foreground" Value="{StaticResource Warn}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="fail">
                                                        <Setter TargetName="chip" Property="Background" Value="#3A1C20"/>
                                                        <Setter TargetName="t" Property="Foreground" Value="{StaticResource Bad}"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Пинг -->
                        <DataGridTemplateColumn x:Name="ColPing" Header="ПИНГ" Width="140" SortMemberPath="LatencyMs">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <controls:PingBars Latency="{Binding LatencyMs, Mode=OneWay}" Margin="0,0,7,0"/>
                                        <TextBlock VerticalAlignment="Center" FontWeight="Normal">
                                            <Run Text="{Binding PingText, Mode=OneWay}"/>
                                            <Run Text="мс" Foreground="{StaticResource Muted}" FontSize="12"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Оценка -->
                        <DataGridTemplateColumn x:Name="ColScore" Header="ОЦЕНКА" Width="130" SortMemberPath="Score">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ProgressBar ToolTip="{Binding ScoreHint}" Width="52" Height="4" Maximum="100" Value="{Binding Score, Mode=OneWay}"
                                                     Foreground="{StaticResource Ok}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Score}" ToolTip="{Binding ScoreHint}" Margin="8,0,0,0" FontWeight="Normal"
                                                   Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Стабильность -->
                        <DataGridTextColumn x:Name="ColStab" Header="СТАБИЛЬНОСТЬ" Binding="{Binding Stability}" Width="125">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                    <Setter Property="FontWeight" Value="Normal"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Источник -->
                        <DataGridTemplateColumn x:Name="ColSource" Header="ИСТОЧНИК" Width="*" MinWidth="170" SortMemberPath="SourcePrettyShort">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <DockPanel ToolTip="{Binding SourceUrl}">
                                        <!-- Только значок: место в колонке нужно пути источника -->
                                        <Button x:Name="srcBtn" DockPanel.Dock="Right" Content="↗" Click="OpenSource_Click"
                                                Style="{StaticResource Ghost}" Padding="8,4" Margin="4,0,6,0" MinHeight="28" FontSize="13"
                                                FontWeight="Normal" ToolTip="Открыть страницу, где найден сервер"/>
                                        <TextBlock Text="{Binding SourcePrettyShort}" Foreground="{StaticResource Muted}" FontWeight="Normal" FontSize="12"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding HasSourceUrl}" Value="False">
                                            <Setter TargetName="srcBtn" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- ================= НИЗ ================= -->
        <StackPanel x:Name="BottomPanel" Grid.Row="4" Margin="0,12,0,0">
            <DockPanel LastChildFill="False">
                <ToggleButton x:Name="AddToggle" Style="{StaticResource LinkToggle}" VerticalAlignment="Center" Content="+ Добавить сервер вручную"
                              Checked="AddToggle_Changed" Unchecked="AddToggle_Changed"/>
                <ToggleButton x:Name="LogToggle" Style="{StaticResource LinkToggle}" VerticalAlignment="Center" Margin="20,0,0,0" Content="Журнал"
                              Checked="LogToggle_Changed" Unchecked="LogToggle_Changed"/>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Label}" VerticalAlignment="Center"
                           Text="Нерабочие серверы удаляются автоматически после проверки"/>
            </DockPanel>

            <StackPanel x:Name="AddPanel" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
                <TextBox x:Name="AddName" Width="170" Tag="Название"/>
                <TextBox x:Name="AddPrimary" Width="140" Margin="8,0,0,0" Tag="Основной IP"/>
                <TextBox x:Name="AddSecondary" Width="140" Margin="8,0,0,0" Tag="Резервный IP"/>
                <TextBox x:Name="AddDoh" Width="280" Margin="8,0,0,0" Tag="DoH: https://…/dns-query"/>
                <Button Content="Добавить" Click="Add_Click" Style="{StaticResource Primary}" Margin="8,0,0,0"/>
            </StackPanel>

            <!-- Журнал: записи с цветом по уровню, фильтр, копирование и очистка -->
            <Border x:Name="LogPanel" Style="{StaticResource Card}" Padding="14,12" Margin="0,10,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" LastChildFill="False">
                        <Button Content="Копировать" Click="CopyLog_Click" Style="{StaticResource Ghost}" DockPanel.Dock="Right"
                                ToolTip="Скопировать записи, которые сейчас видны"/>
                        <Button Content="Очистить" Click="ClearLog_Click" Style="{StaticResource Ghost}" DockPanel.Dock="Right"/>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="Журнал" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LogCount" Margin="12,0,16,0" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                            <Border Padding="3" CornerRadius="9" Background="{StaticResource Surface2}"
                                    BorderBrush="{StaticResource Border}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Tab}" GroupName="log" IsChecked="True" Tag="0" Checked="LogFilter_Checked" Content="Все"/>
                                    <RadioButton Style="{StaticResource Tab}" GroupName="log" Tag="1" Checked="LogFilter_Checked" Content="Предупреждения"/>
                                    <RadioButton Style="{StaticResource Tab}" GroupName="log" Tag="2" Checked="LogFilter_Checked" Content="Ошибки"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <ListBox x:Name="LogList" Grid.Row="1" Height="200" Margin="0,10,0,0" Background="Transparent" BorderThickness="0"
                             SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="LogList_MouseDoubleClick" PreviewKeyDown="LogList_PreviewKeyDown"
                             AutomationProperties.Name="Записи журнала (Ctrl+C копирует выбранные)">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Копировать строку" Click="CopyLine_Click" InputGestureText="Ctrl+C"/>
                                <MenuItem Header="Копировать всё видимое" Click="CopyAll_Click"/>
                                <Separator/>
                                <MenuItem Header="Очистить журнал" Click="ClearLog_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" Background="Transparent" CornerRadius="4" Padding="6,1">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#263F66"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#242832"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.RenderTransform>
                                        <TranslateTransform x:Name="shift"/>
                                    </Grid.RenderTransform>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{Binding Bar}" CornerRadius="2"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TimeText}" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                               Foreground="{StaticResource Muted}" Margin="10,2,14,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Text}" Foreground="{Binding TextBrush}" TextWrapping="Wrap" FontSize="12"/>
                                    <Grid.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"/>
                                                    <DoubleAnimation Storyboard.TargetName="shift" Storyboard.TargetProperty="Y" From="8" To="0" Duration="0:0:0.25">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Grid.Triggers>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ================= УВЕДОМЛЕНИЕ В УГЛУ ================= -->
        <!-- Отмена последнего действия и короткое пояснение к нему. Пока панель видна, уведомление справа внизу не появляется:
             его текст уходит во вторую строку. Полоска снизу и секунды показывают, когда панель исчезнет; под мышью отсчет стоит. -->
        <Border x:Name="UndoBar" Grid.RowSpan="5" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,22"
                CornerRadius="10" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                Visibility="Collapsed" Panel.ZIndex="10" MouseEnter="UndoBar_MouseEnter" MouseLeave="UndoBar_MouseLeave">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.45" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="16,8,8,10">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" MaxWidth="460">
                        <TextBlock x:Name="UndoText" FontSize="13" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="UndoHint" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                   Margin="0,2,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                    <Button Content="Отменить" Click="Undo_Click" Style="{StaticResource Strong}" MinHeight="28" Padding="12,4" Margin="0"
                            VerticalAlignment="Center" ToolTip="Вернуть как было (Ctrl+Z)"/>
                    <TextBlock x:Name="UndoSeconds" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"
                               Margin="10,0,0,0" MinWidth="20" ToolTip="Панель исчезнет через это время. Наведите мышь, чтобы остановить отсчет"/>
                    <Button Content="✕" Click="UndoClose_Click" Style="{StaticResource Ghost}" MinHeight="28" Padding="8,4" Margin="2,0,0,0"
                            VerticalAlignment="Center" ToolTip="Скрыть"/>
                </StackPanel>
                <!-- Сколько осталось: полоска сжимается к левому краю -->
                <Border Height="2" VerticalAlignment="Bottom" Margin="12,0,12,3" CornerRadius="1" Background="{StaticResource Accent}"
                        Opacity="0.7" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="UndoTimeScale" ScaleX="1"/>
                    </Border.RenderTransform>
                </Border>
            </Grid>
        </Border>

        <Border x:Name="Toast" Grid.RowSpan="5" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,0,28" Padding="16,10" CornerRadius="10" Background="{StaticResource Surface2}"
                BorderBrush="{StaticResource Border}" BorderThickness="1" Opacity="0" IsHitTestVisible="False">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastShift" Y="12"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.5" Color="#000000"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="ToastDot" Width="8" Height="8" Fill="{StaticResource Ok}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="ToastText" FontSize="13"/>
            </StackPanel>
        </Border>
    </Grid>
    </DockPanel>
</Window>
